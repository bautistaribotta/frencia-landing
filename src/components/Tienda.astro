---
// Insignia de tienda en estado "Próximamente": no es un enlace todavía.
// Los logos salen de simple-icons y se dibujan en el build, sin JS.
import { siApple, siGoogleplay } from 'simple-icons';

interface Props {
  tienda: 'google-play' | 'app-store';
  class?: string;
}

const { tienda, class: clase } = Astro.props;
const { nombre, icono } =
  tienda === 'google-play'
    ? { nombre: 'Google Play', icono: siGoogleplay }
    : { nombre: 'App Store', icono: siApple };
---

<div
  class:list={[
    'inline-flex h-(--control-h-lg) items-center gap-3 rounded-lg border border-dashed border-border-default bg-surface-chip pr-5 pl-4 text-fg-secondary max-[700px]:gap-2 max-[700px]:pr-3 max-[700px]:pl-3',
    clase,
  ]}
  aria-label={`${nombre}, próximamente`}
>
  <svg class="size-5 flex-none fill-current max-[370px]:hidden" viewBox="0 0 24 24" aria-hidden="true">
    <path d={icono.path} />
  </svg>
  <span class="flex flex-col gap-1.5 whitespace-nowrap">
    <span class="rotulo text-(length:--fs-label-sm) leading-none!">Próximamente<span class="max-[700px]:hidden"> en</span></span>
    <span class="text-base leading-none font-semibold text-fg-primary">{nombre}</span>
  </span>
</div>
