---
// Barra de navegación fija. Se oculta al bajar y vuelve apenas se sube; arriba
// de todo se ve siempre.
// - Escritorio: barra angosta y centrada, selector de tema suelto a la derecha
//   (debajo de 900px la barra se corre a la izquierda para dejarle lugar).
// - Teléfono (hasta 700px): logo y hamburguesa; los links y el tema van en el
//   menú que se despliega.
import { Menu, X } from 'lucide-react';
import SelectorTema from './SelectorTema.astro';

const links = [
  ['#historia', 'Nuestra historia'],
  ['#aplicacion', 'Aplicación'],
  ['#contacto', 'Contacto'],
];
---

<div
  class="fixed inset-x-0 top-0 z-(--z-nav) pt-6 transition-transform duration-(--dur-slow) ease-out data-oculta:-translate-y-[calc(100%+24px)]"
  data-barra
>
  <div
    class="relative mx-auto flex w-full max-w-(--contenido-max) items-center justify-between gap-4 px-(--pad-pagina) max-[900px]:px-5 min-[900px]:justify-center"
  >
    <header
      class="glass glass-denso flex w-fit items-center gap-6 rounded-pill py-1.5 pr-1.5 pl-6 max-[700px]:w-full max-[700px]:justify-between"
    >
      <a class="marca no-underline" href="#inicio" aria-label="Frencia, inicio">FRENCIA.</a>
      <nav class="flex gap-1 max-[700px]:hidden" aria-label="Secciones">
        {
          links.map(([href, texto]) => (
            <a
              href={href}
              class="inline-flex h-(--hit-min) items-center rounded-pill px-3.5 text-sm font-medium text-fg-secondary no-underline transition-colors duration-(--dur-base) ease-out hover:bg-surface-chip hover:text-fg-primary"
            >
              {texto}
            </a>
          ))
        }
      </nav>
      <button
        type="button"
        class="group inline-flex size-(--hit-min) cursor-pointer items-center justify-center rounded-pill border-0 bg-transparent text-fg-primary transition-colors duration-(--dur-base) hover:bg-surface-chip min-[700px]:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        data-menu-boton
      >
        <Menu aria-hidden="true" size={20} strokeWidth={1.75} className="group-aria-expanded:hidden" />
        <X aria-hidden="true" size={20} strokeWidth={1.75} className="hidden group-aria-expanded:block" />
      </button>
    </header>

    <div class="glass glass-denso rounded-pill p-1.5 max-[700px]:hidden min-[900px]:absolute min-[900px]:right-(--pad-pagina)">
      <SelectorTema />
    </div>

    <div
      id="menu-movil"
      class="glass glass-denso absolute inset-x-5 top-full mt-2 flex flex-col gap-4 rounded-2xl p-3 transition-[opacity,translate] duration-(--dur-base) ease-out not-data-abierto:pointer-events-none not-data-abierto:-translate-y-2 not-data-abierto:opacity-0 min-[700px]:hidden"
      inert
      data-menu
    >
      <nav class="flex flex-col" aria-label="Secciones">
        {
          links.map(([href, texto]) => (
            <a
              href={href}
              class="flex min-h-12 items-center rounded-lg px-4 text-base font-medium text-fg-primary no-underline transition-colors duration-(--dur-base) hover:bg-surface-chip"
            >
              {texto}
            </a>
          ))
        }
      </nav>
      <div class="flex items-center justify-between border-t border-divider px-4 pt-3">
        <span class="rotulo">Tema</span>
        <SelectorTema />
      </div>
    </div>
  </div>
</div>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra]')!;
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  // Cuánto hay que moverse para que la barra cambie de estado, así un temblor
  // del scroll no la hace parpadear.
  const UMBRAL = 8;
  // Debajo de esta altura la barra se ve siempre.
  const ARRIBA = 80;

  let ultimoY = window.scrollY;
  // Mientras dura el scroll suave de un link de la barra, no se oculta.
  let navegando = false;

  function mostrar(visible: boolean) {
    barra.toggleAttribute('data-oculta', !visible);
  }

  function abrirMenu(abierto: boolean) {
    boton.setAttribute('aria-expanded', String(abierto));
    boton.setAttribute('aria-label', abierto ? 'Cerrar menú' : 'Abrir menú');
    menu.toggleAttribute('data-abierto', abierto);
    menu.inert = !abierto;
    if (abierto) mostrar(true);
  }

  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      const delta = y - ultimoY;
      if (y < ARRIBA || navegando || menu.hasAttribute('data-abierto')) {
        if (y < ARRIBA) mostrar(true);
        ultimoY = y;
        return;
      }
      if (Math.abs(delta) < UMBRAL) return;
      mostrar(delta < 0);
      ultimoY = y;
    },
    { passive: true },
  );

  barra.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
    a.addEventListener('click', () => {
      abrirMenu(false);
      navegando = true;
      const fin = () => {
        navegando = false;
        ultimoY = window.scrollY;
      };
      if ('onscrollend' in window) window.addEventListener('scrollend', fin, { once: true });
      else setTimeout(fin, 1000);
    }),
  );

  boton.addEventListener('click', () => abrirMenu(boton.getAttribute('aria-expanded') !== 'true'));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu.hasAttribute('data-abierto')) {
      abrirMenu(false);
      boton.focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (menu.hasAttribute('data-abierto') && !barra.contains(e.target as Node)) abrirMenu(false);
  });

  window.matchMedia('(min-width: 700px)').addEventListener('change', (e) => {
    if (e.matches) abrirMenu(false);
  });
</script>
