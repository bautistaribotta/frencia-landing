---
// Barra de navegación fija. Se oculta al bajar y vuelve apenas se sube; arriba
// de todo se ve siempre, y también mientras tiene el foco del teclado.
// - Escritorio: barra angosta y centrada; el botón de tema, suelto en la esquina
//   de arriba a la derecha, a la misma distancia de los dos bordes.
// - Teléfono (hasta 700px): logo y hamburguesa; los links y el tema van en un
//   popover nativo, que ya resuelve Escape, el toque afuera y el foco.
// Un solo <nav>: en cada tamaño se ve una sola de las dos listas.
import Icono from './Icono.astro';
import SelectorTema from './SelectorTema.astro';

const links = [
  ['#historia', 'Nuestra historia'],
  ['#aplicacion', 'Aplicación'],
  ['#contacto', 'Contacto'],
];
---

<div
  class="fixed inset-x-0 top-0 z-(--z-nav) pt-6 transition-transform duration-(--dur-slow) ease-out motion-reduce:transition-none data-oculta:not-focus-within:-translate-y-[calc(100%+24px)]"
  data-barra
>
  <div
    class="relative mx-auto flex w-full max-w-(--contenido-max) items-center justify-center gap-4 px-(--pad-pagina) max-[900px]:px-5"
  >
    <!-- scroll-target-group marca el link de la sección que se está viendo
         (:target-current). Va en el header para que el logo (#inicio) también
         sea parte del grupo: arriba de todo la sección actual es el inicio, que
         no se marca, y así ninguna opción del nav queda resaltada. -->
    <header
      class="glass glass-denso flex w-fit items-center gap-6 rounded-pill py-1.5 pr-1.5 pl-6 [scroll-target-group:auto] max-[700px]:w-full max-[700px]:justify-between"
    >
      <a class="marca no-underline" href="#inicio" aria-label="Frencia, inicio">FRENCIA.</a>
      <nav class="flex items-center" aria-label="Secciones">
        <ul class="flex gap-1 max-[700px]:hidden" data-links>
          {
            links.map(([href, texto]) => (
              <li>
                <a
                  href={href}
                  class="inline-flex min-h-(--hit-min) items-center rounded-pill px-3.5 text-sm font-medium text-fg-secondary no-underline transition-colors duration-(--dur-base) ease-out hover:bg-surface-chip hover:text-fg-primary [&:target-current]:bg-surface-chip [&:target-current]:text-fg-primary"
                >
                  {texto}
                </a>
              </li>
            ))
          }
        </ul>
        <button
          type="button"
          class="group inline-flex size-(--hit-min) cursor-pointer items-center justify-center rounded-pill border-0 bg-transparent text-fg-primary transition-colors duration-(--dur-base) hover:bg-surface-chip min-[700px]:hidden"
          popovertarget="menu-movil"
          aria-controls="menu-movil"
          aria-expanded="false"
          aria-label="Menú"
          data-menu-boton
        >
          <Icono nombre="menu" size={20} class="group-aria-expanded:hidden" />
          <Icono nombre="cerrar" size={20} class="hidden group-aria-expanded:block" />
        </button>
        <!-- El popover no lleva clases de display: le ganarían al display:none
             con el que el navegador lo esconde cerrado. El layout va adentro. -->
        <div id="menu-movil" class="menu glass glass-denso rounded-2xl p-3 text-fg-primary min-[700px]:hidden" popover data-menu>
          <div class="flex flex-col gap-4">
            <ul class="flex flex-col">
              {
                links.map(([href, texto]) => (
                  <li>
                    <a
                      href={href}
                      class="flex min-h-12 items-center rounded-lg px-4 text-base font-medium text-fg-primary no-underline transition-colors duration-(--dur-base) hover:bg-surface-chip"
                    >
                      {texto}
                    </a>
                  </li>
                ))
              }
            </ul>
            <div class="flex items-center justify-between border-t border-divider px-4 pt-3">
              <span class="rotulo">Tema</span>
              <SelectorTema />
            </div>
          </div>
        </div>
      </nav>
    </header>
  </div>

  <div class="absolute top-6 right-6 max-[700px]:hidden">
    <SelectorTema />
  </div>
</div>

<style>
  /* El popover va en la capa superior: se ubica contra la ventana, debajo de
     la barra (24px de margen + 56px de barra + 8px de separación). */
  .menu {
    position: fixed;
    inset: calc(var(--space-7) + var(--hit-min) + 12px + var(--space-3)) var(--space-6) auto;
    width: auto;
    margin: 0;
    opacity: 0;
    transition:
      opacity var(--dur-base) var(--ease-out),
      translate var(--dur-base) var(--ease-out),
      display var(--dur-base),
      overlay var(--dur-base);
    /* Aparte del shorthand: si va adentro, los navegadores viejos descartan
       toda la transición. */
    transition-behavior: allow-discrete;
  }
  .menu:is(:popover-open, .\:popover-open) {
    opacity: 1;
  }
  @starting-style {
    .menu:is(:popover-open, .\:popover-open) {
      opacity: 0;
    }
  }
  /* Con movimiento reducido, el menú solo aparece con un fundido. */
  @media (prefers-reduced-motion: no-preference) {
    .menu {
      translate: 0 -8px;
    }
    .menu:is(:popover-open, .\:popover-open) {
      translate: 0 0;
    }
    @starting-style {
      .menu:is(:popover-open, .\:popover-open) {
        translate: 0 -8px;
      }
    }
  }
</style>

<script>
  // Popover es Baseline desde 2025: los navegadores anteriores cargan el
  // polyfill, y solo ellos.
  if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
    import('@oddbird/popover-polyfill');
  }

  const barra = document.querySelector<HTMLElement>('[data-barra]')!;
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  // Cuánto hay que moverse para que la barra cambie de estado, así un temblor
  // del scroll no la hace parpadear.
  const UMBRAL = 8;
  // Debajo de esta altura la barra se ve siempre.
  const ARRIBA = 80;

  // Se toma en el primer scroll: leer scrollY al cargar fuerza un layout de toda
  // la pagina antes del primer render.
  let ultimoY: number | null = null;
  // Mientras dura el scroll suave de un link de la barra, no se oculta.
  let navegando = false;

  const menuAbierto = () => menu.matches(':is(:popover-open, .\\:popover-open)');

  function mostrar(visible: boolean) {
    barra.toggleAttribute('data-oculta', !visible);
  }

  window.addEventListener(
    'scroll',
    () => {
      const y = window.scrollY;
      if (ultimoY === null) {
        ultimoY = y;
        return;
      }
      const delta = y - ultimoY;
      if (y < ARRIBA || navegando || menuAbierto()) {
        if (y < ARRIBA) mostrar(true);
        ultimoY = y;
        return;
      }
      if (Math.abs(delta) < UMBRAL) return;
      mostrar(delta < 0);
      ultimoY = y;
    },
    { passive: true },
  );

  // El navegador abre y cierra el menú; esto solo refleja el estado en el
  // botón (el icono cambia con aria-expanded) y muestra la barra al abrir.
  menu.addEventListener('toggle', (e) => {
    const abierto = (e as ToggleEvent).newState === 'open';
    boton.setAttribute('aria-expanded', String(abierto));
    if (abierto) mostrar(true);
  });

  barra.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) =>
    a.addEventListener('click', () => {
      if (menuAbierto()) menu.hidePopover();
      navegando = true;
      const fin = () => {
        navegando = false;
        ultimoY = window.scrollY;
      };
      if ('onscrollend' in window) window.addEventListener('scrollend', fin, { once: true });
      else setTimeout(fin, 1000);
    }),
  );

  window.matchMedia('(min-width: 700px)').addEventListener('change', (e) => {
    if (e.matches && menuAbierto()) menu.hidePopover();
  });

  // El link de la sección visible se marca con CSS; aria-current lo anuncia a
  // los lectores de pantalla. Se actualiza cuando termina el scroll. Arriba de
  // todo el actual es el logo, que no está en [data-links]: no queda ninguno.
  if (CSS.supports('scroll-target-group', 'auto')) {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-links] a');
    const marcarActual = () => {
      const actual = document.querySelector('[data-links] a:target-current');
      links.forEach((l) => (l === actual ? l.setAttribute('aria-current', 'true') : l.removeAttribute('aria-current')));
    };
    // :target-current se actualiza al pintar el cuadro siguiente: se lee
    // después, para no dejar aria-current con la sección anterior.
    const despuesDePintar = () => requestAnimationFrame(() => requestAnimationFrame(marcarActual));
    despuesDePintar();
    document.addEventListener('scrollend', despuesDePintar);
  }
</script>
