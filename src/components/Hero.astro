---
import { Picture } from 'astro:assets';
import Icono from './Icono.astro';
import Acciones from './Acciones.astro';
import fotoHero from '../assets/fotos/hero-sentadilla.jpg';

const contenedor = 'relative z-2 mx-auto w-full max-w-(--contenido-max) px-(--pad-pagina) max-[900px]:px-5';
---

<section class="relative isolate flex min-h-[56rem] flex-col max-[900px]:min-h-0" id="inicio">
  <!-- Lugar de la barra fija (Barra.astro): 24px de margen + 56px de barra. -->
  <div class="h-20" aria-hidden="true"></div>

  <div
    class:list={[
      contenedor,
      'grid flex-1 grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] items-center gap-16 pt-[72px] pb-24 max-[900px]:grid-cols-1 max-[900px]:gap-10 max-[900px]:pt-12 max-[900px]:pb-16',
    ]}
  >
    <div class="flex flex-col gap-7">
      <h1
        class="font-display text-[clamp(3rem,0.5rem+6.5vw,6rem)] leading-[0.98] font-medium tracking-[-0.035em] text-balance"
        id="hero-titulo"
      >
        Cada serie cuenta.
      </h1>
      <p class="bajada">
        Traés la rutina que ya tenés en papel y Frencia la convierte en un registro vivo. Registrá cada serie, seguí tu
        progresión y dejá que las cuentas se hagan solas.
      </p>
      <Acciones />
    </div>

    <div class="relative order-first max-[900px]:order-none">
      <div class="foto aspect-4/5">
        <Picture
          src={fotoHero}
          formats={['avif', 'webp']}
          pictureAttributes={{ class: 'contents' }}
          alt="Atleta de espaldas con una barra cargada sobre los hombros, lista para una sentadilla"
          widths={[480, 720, 1080]}
          sizes="(max-width: 900px) 100vw, 560px"
          loading="eager"
          fetchpriority="high"
          class="object-[62%_center]"
        />
      </div>
      <div
        class="glass glass-fuerte absolute -right-10 bottom-10 flex w-[280px] flex-col gap-3.5 p-5 max-[900px]:right-4 max-[900px]:bottom-4 max-[900px]:left-4 max-[900px]:w-auto"
        role="group"
        aria-label="Ejemplo de serie registrada"
      >
        <div class="flex items-center justify-between">
          <span class="rotulo">Serie 3 de 4</span>
          <span class="meta">SENTADILLA</span>
        </div>
        <div class="flex items-baseline gap-2 font-display tabular-nums [font-variation-settings:var(--vs-condensed)]">
          <span class="text-[3.5rem] leading-none font-medium tracking-[-0.035em]">82.5</span>
          <span class="text-xl text-fg-primary">kg × 8</span>
        </div>
        <div class="flex items-center justify-between">
          <span
            class="type-data inline-flex items-center gap-1.5 bg-(--surface-intensity-soft) px-2.5 py-1 font-semibold text-(--intensity-text) shadow-(--halo-intensity)"
          >
            <Icono nombre="llama" size={16} />
            RIR 2
          </span>
        </div>
        <div class="grid grid-cols-4 gap-1.5" aria-hidden="true">
          <span class="h-[3px] rounded-xs bg-fg-primary"></span>
          <span class="h-[3px] rounded-xs bg-fg-primary"></span>
          <span class="h-[3px] rounded-xs bg-signal shadow-halo-signal"></span>
          <span class="h-[3px] rounded-xs bg-(--data-track)"></span>
        </div>
      </div>
    </div>
  </div>

  <div class={contenedor}>
    <a
      class="inline-flex items-center gap-2 pb-10 text-sm text-fg-tertiary no-underline transition-colors duration-(--dur-base) hover:text-fg-secondary"
      href="#historia"
    >
      <span class="flecha inline-flex">
        <Icono nombre="flecha-abajo" size={16} />
      </span>
      Conocé la historia
    </a>
  </div>
</section>

<style>
  /* La flecha sube y baja en un pulso lento: invita a seguir bajando. Hace dos
     pulsos y se queda quieta, asi no se mueve mas de 5 segundos (WCAG 2.2.2). */
  .flecha {
    @media (prefers-reduced-motion: no-preference) {
      animation: pulso-flecha 1.8s var(--ease-in-out) 2;
    }
  }
  @keyframes pulso-flecha {
    0%, 100% { transform: translateY(-2px); }
    50% { transform: translateY(4px); }
  }
</style>
