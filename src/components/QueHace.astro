---
import { Image } from 'astro:assets';
import { Flame } from 'lucide-react';
import capturaApp from '../assets/fotos/app-inicio.jpg';
import fotoCardio from '../assets/fotos/cardio-carrera.jpg';

const metricas = [
  { sigla: 'RIR', titulo: 'Repeticiones en reserva', texto: 'Cuántas te quedaron en reserva, anotadas en cada serie.' },
  { sigla: 'RPE', titulo: 'Escala de Esfuerzo percibido', texto: '¿No usas RIR? No importa, RPE también esta disponible.' },
];
---

<!-- En el teléfono el vidrio va sin desenfoque: las capas con backdrop-filter
     sobre el fondo hacen que el navegador del celular deje pedazos sin pintar.
     Sobre el fondo liso, el blur casi no se nota. -->
<section
  class="relative isolate flex min-h-[56rem] flex-col max-[900px]:min-h-0 max-[900px]:[--glass-filter:none] max-[900px]:[--sheet-filter:none]"
  id="aplicacion"
  aria-labelledby="hace-titulo"
>
  <div
    class="relative z-2 mx-auto grid w-full max-w-(--contenido-max) flex-1 grid-cols-[minmax(0,340px)_minmax(0,1fr)] content-center items-center gap-x-[72px] gap-y-8 px-(--pad-pagina) py-[120px] max-[900px]:grid-cols-1 max-[900px]:gap-y-10 max-[900px]:px-5 max-[900px]:py-20"
  >
    <div class="glass glass-denso row-span-2 flex rounded-[44px] p-3 max-[900px]:row-span-1 max-[900px]:w-full max-[900px]:max-w-[320px] max-[900px]:justify-self-center">
      <div class="relative aspect-739/1511 flex-1 overflow-hidden rounded-[34px] bg-surface-inset">
        <Image
          src={capturaApp}
          alt="Pantalla de inicio de la app de Frencia con los días de la rutina Torso-Piernas y el botón para empezar el entrenamiento"
          widths={[320, 640]}
          sizes="(max-width: 900px) 296px, 316px"
          class="absolute inset-0 size-full object-cover object-top"
        />
      </div>
    </div>

    <div class="flex flex-col gap-6 self-end max-[900px]:order-first">
      <p class="rotulo">Aplicación</p>
      <h2 class="titulo-seccion" id="hace-titulo">No genera rutinas. Registra las tuyas.</h2>
      <p class="bajada">
        Cargá la rutina que ya usás y registrá cada serie a tu manera. Frencia hace las cuentas que usan los atletas.
      </p>
    </div>

    <div class="grid grid-cols-3 gap-5 self-start max-[1080px]:grid-cols-1 max-[900px]:grid-cols-3 max-[560px]:grid-cols-1">
      {
        metricas.map((m) => (
          <article class="glass flex min-h-[260px] flex-col gap-2.5 rounded-xl p-6">
            <span class="mb-auto flex items-center gap-2 font-display text-[44px] leading-none font-semibold tracking-[-0.02em] text-(--intensity-text) [font-variation-settings:var(--vs-condensed)]">
              {m.sigla}
              <Flame aria-hidden="true" size={20} strokeWidth={1.75} />
            </span>
            <h3 class="type-subtitle tracking-[-0.01em]">{m.titulo}</h3>
            <p class="type-body-sm text-fg-secondary">{m.texto}</p>
          </article>
        ))
      }

      <article
        class="glass relative flex min-h-[260px] flex-col justify-end overflow-hidden rounded-xl after:absolute after:inset-0 after:bg-linear-to-t after:from-bg-app after:from-8% after:to-transparent after:to-75% after:content-['']"
      >
        <Image
          src={fotoCardio}
          alt="Corredor en plena carrera por una avenida"
          widths={[400, 640, 960]}
          sizes="(max-width: 560px) 100vw, (max-width: 1080px) 50vw, 240px"
          class="absolute inset-0 size-full object-cover object-[center_30%]"
        />
        <div class="relative z-1 flex flex-col gap-2 p-6">
          <h3 class="type-subtitle tracking-[-0.01em]">Cardio e isométricos</h3>
          <p class="type-body-sm text-fg-secondary">Tiempo, distancia y holds, en el mismo registro.</p>
        </div>
      </article>
    </div>
  </div>
</section>
