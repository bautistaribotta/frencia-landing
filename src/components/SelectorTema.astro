---
// Botón de tema, el mismo del acceso de frencia-web: muestra el tema que se ve,
// luna en oscuro y sol en claro, y un toque pasa al otro. Sin elección sigue al
// sistema. Escribe data-theme en <html> y lo recuerda en localStorage; el script
// inline de Layout lo aplica antes de pintar para que no parpadee.
import { Moon, Sun } from 'lucide-react';
---

<button
  type="button"
  class="glass inline-flex size-10 flex-none cursor-pointer items-center justify-center rounded-md text-fg-secondary transition-colors duration-(--dur-fast) ease-out hover:bg-surface-card-elevated hover:text-fg-primary"
  aria-label="Cambiar tema"
  data-boton-tema
>
  <Moon aria-hidden="true" size={20} strokeWidth={1.75} className="luna" />
  <Sun aria-hidden="true" size={20} strokeWidth={1.75} className="sol" />
</button>

<style>
  /* El icono sale del CSS y no del script: así se ve bien desde la primera pintada. */
  [data-boton-tema] :global(.sol) { display: none; }
  :global(:root[data-theme='light']) [data-boton-tema] :global(.sol) { display: block; }
  :global(:root[data-theme='light']) [data-boton-tema] :global(.luna) { display: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) [data-boton-tema] :global(.sol) { display: block; }
    :global(:root:not([data-theme='dark'])) [data-boton-tema] :global(.luna) { display: none; }
  }
</style>

<script>
  const raiz = document.documentElement;
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-boton-tema]');
  const sistemaClaro = window.matchMedia('(prefers-color-scheme: light)');

  // Lo que se está pintando: el tema elegido o, si no hay, el del sistema.
  function temaActual() {
    return raiz.dataset.theme ?? (sistemaClaro.matches ? 'light' : 'dark');
  }

  function etiquetar() {
    const etiqueta = temaActual() === 'dark' ? 'Pasar a modo claro' : 'Pasar a modo oscuro';
    botones.forEach((b) => {
      b.setAttribute('aria-label', etiqueta);
      b.title = etiqueta;
    });
  }

  function alternar() {
    const tema = temaActual() === 'dark' ? 'light' : 'dark';
    raiz.dataset.theme = tema;
    try {
      localStorage.setItem('tema', tema);
    } catch {
      // Sin almacenamiento (modo privado): el tema dura hasta recargar.
    }
    etiquetar();
  }

  etiquetar();
  sistemaClaro.addEventListener('change', etiquetar);
  botones.forEach((b) => b.addEventListener('click', alternar));
</script>
