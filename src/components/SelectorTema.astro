---
// Botón de tema, el mismo del acceso de frencia-web: muestra el tema que se ve,
// luna en oscuro y sol en claro, y un toque pasa al otro. Sin elección sigue al
// sistema; si el toque vuelve al tema del sistema, se borra la elección y la
// página lo vuelve a seguir. Escribe data-theme en <html> y el meta
// color-scheme, y lo recuerda en localStorage; el script inline de Layout lo
// aplica antes de pintar para que no parpadee.
import { Moon, Sun } from '@lucide/astro';
---

<button
  type="button"
  class="glass inline-flex size-10 flex-none cursor-pointer items-center justify-center rounded-md text-fg-secondary transition-colors duration-(--dur-fast) ease-out hover:bg-surface-card-elevated hover:text-fg-primary"
  data-boton-tema
>
  <!-- Icono y etiqueta salen del CSS y no del script: así son correctos desde la
       primera pintada y siguen al sistema aunque el JS no cargue. -->
  <span class="luna inline-flex">
    <Moon aria-hidden="true" size={20} stroke-width={1.75} />
    <span class="sr-only">Pasar a modo claro</span>
  </span>
  <span class="sol inline-flex">
    <Sun aria-hidden="true" size={20} stroke-width={1.75} />
    <span class="sr-only">Pasar a modo oscuro</span>
  </span>
</button>

<style>
  [data-boton-tema] .sol { display: none; }
  :global(:root[data-theme='light']) [data-boton-tema] .sol { display: inline-flex; }
  :global(:root[data-theme='light']) [data-boton-tema] .luna { display: none; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) [data-boton-tema] .sol { display: inline-flex; }
    :global(:root:not([data-theme='dark'])) [data-boton-tema] .luna { display: none; }
  }
</style>

<script>
  const raiz = document.documentElement;
  const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
  const sistemaClaro = window.matchMedia('(prefers-color-scheme: light)');

  const temaSistema = () => (sistemaClaro.matches ? 'light' : 'dark');

  function aplicar(tema: string | null) {
    if (tema === 'light' || tema === 'dark') raiz.dataset.theme = tema;
    else delete raiz.dataset.theme;
    if (meta) meta.content = raiz.dataset.theme ?? 'light dark';
  }

  // Pasa al contrario de lo que se ve. Si ese es el tema del sistema, el
  // usuario está deshaciendo su elección: se borra en vez de guardarla, así la
  // página vuelve a seguir al sistema. Lo guardado no se toca si después el
  // sistema cambia y coincide (si no, no se podría fijar un tema).
  function alternar() {
    const visto = raiz.dataset.theme ?? temaSistema();
    const destino = visto === 'dark' ? 'light' : 'dark';
    const guardar = destino === temaSistema() ? null : destino;
    aplicar(guardar);
    try {
      if (guardar) localStorage.setItem('tema', guardar);
      else localStorage.removeItem('tema');
    } catch {
      // Sin almacenamiento (modo privado): el tema dura hasta recargar.
    }
  }

  document.querySelectorAll('[data-boton-tema]').forEach((b) => b.addEventListener('click', alternar));

  // Otra pestaña cambió el tema: esta lo sigue.
  window.addEventListener('storage', (e) => {
    if (e.key === 'tema' || e.key === null) aplicar(e.newValue);
  });
</script>
