---
// Selector de tema: sistema, oscuro o claro. Escribe data-theme en <html> y lo
// recuerda en localStorage; el script inline de Layout lo aplica antes de
// pintar para que no parpadee.
import { Monitor, Moon, Sun } from 'lucide-react';

const opciones = [
  { tema: 'system', etiqueta: 'Tema del sistema', Icono: Monitor },
  { tema: 'dark', etiqueta: 'Tema oscuro', Icono: Moon },
  { tema: 'light', etiqueta: 'Tema claro', Icono: Sun },
] as const;
---

<div class="flex gap-0.5 rounded-pill bg-surface-chip p-[3px]" role="group" aria-label="Tema" data-selector-tema>
  {
    opciones.map(({ tema, etiqueta, Icono }) => (
      <button
        type="button"
        data-tema={tema}
        aria-pressed={tema === 'system' ? 'true' : 'false'}
        aria-label={etiqueta}
        class="inline-flex h-[38px] w-(--hit-min) cursor-pointer items-center justify-center rounded-pill border-0 bg-transparent text-fg-tertiary transition-colors duration-(--dur-base) ease-out hover:text-fg-primary aria-pressed:bg-surface-card-elevated aria-pressed:text-fg-primary aria-pressed:shadow-sm"
      >
        <Icono aria-hidden="true" size={16} strokeWidth={1.75} />
      </button>
    ))
  }
</div>

<script>
  type Tema = 'system' | 'dark' | 'light';

  const raiz = document.documentElement;
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-selector-tema] button');

  function marcar(tema: Tema) {
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tema === tema)));
  }

  function aplicar(tema: Tema) {
    if (tema === 'system') delete raiz.dataset.theme;
    else raiz.dataset.theme = tema;
    try {
      if (tema === 'system') localStorage.removeItem('tema');
      else localStorage.setItem('tema', tema);
    } catch {
      // Sin almacenamiento (modo privado): el tema dura hasta recargar.
    }
    marcar(tema);
  }

  marcar((raiz.dataset.theme as Tema | undefined) ?? 'system');
  botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.tema as Tema)));
</script>
