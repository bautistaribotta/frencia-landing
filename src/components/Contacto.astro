---
import Acciones from './Acciones.astro';
---

<section class="relative isolate" id="contacto">
  <div
    class="relative z-2 mx-auto flex w-full max-w-(--contenido-max) flex-col px-(--pad-pagina) pt-[120px] pb-[72px] max-[900px]:px-5 max-[900px]:pt-20"
  >
    <div class="flex max-w-[46rem] flex-col gap-7">
      <h2 class="titulo-seccion" id="contacto-titulo">Cargá la rutina que ya usás. Del resto se encarga Frencia.</h2>
      <Acciones />
    </div>
  </div>
</section>
