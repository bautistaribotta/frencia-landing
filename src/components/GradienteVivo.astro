---
// Gradiente vivo: el fondo de toda la pagina. Manchas de verde Lume que derivan
// despacio sobre negro (bg-app en el tema claro), fijas a la ventana y detras
// de todas las secciones, asi no hay cortes entre una y otra. Cada mancha es un
// gradiente radial (sin filter: blur, que es caro de animar) y se mueve solo
// con transform. Los colores salen de los tokens que ya cambian con el tema
// (--glow-a, --glow-b, --signal) y la intensidad, de --fondo-ganancia.
---

<div class="vivo" aria-hidden="true">
  <div class="vivo__mancha vivo__mancha--a"></div>
  <div class="vivo__mancha vivo__mancha--b"></div>
  <div class="vivo__mancha vivo__mancha--c"></div>
  <div class="vivo__mancha vivo__mancha--d"></div>
  <div class="vivo__mancha vivo__mancha--e"></div>
  <div class="vivo__mancha vivo__mancha--f"></div>
  <div class="vivo__grano"></div>
</div>

<style>
  .vivo {
    --g: var(--fondo-ganancia, 1);
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    /* Negro en el tema oscuro; en el claro, la base de siempre. */
    background: light-dark(var(--bg-app), oklch(0% 0 0));
    pointer-events: none;
  }

  .vivo__mancha {
    position: absolute;
    border-radius: 50%;
    will-change: transform;
    animation: var(--deriva) var(--dur) var(--ease-in-out) infinite alternate;
  }

  /* Lima brillante arriba a la derecha: la luz principal. */
  .vivo__mancha--a {
    --deriva: deriva-a;
    --dur: 30s;
    width: 62vmax;
    aspect-ratio: 1;
    top: -22vmax;
    right: -14vmax;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--glow-a) min(100%, calc(72% * var(--g))), transparent) 0%, color-mix(in oklch, var(--glow-a) min(100%, calc(26% * var(--g))), transparent) 55%, transparent 100%);
  }

  /* Bosque profundo abajo a la izquierda (en claro, un blanco que lava). */
  .vivo__mancha--b {
    --deriva: deriva-b;
    --dur: 36s;
    width: 80vmax;
    aspect-ratio: 1;
    bottom: -38vmax;
    left: -26vmax;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--glow-b) min(100%, calc(95% * var(--g))), transparent) 0%, color-mix(in oklch, var(--glow-b) min(100%, calc(45% * var(--g))), transparent) 50%, transparent 100%);
  }

  /* Verde señal que cruza por el medio, detras del titulo. */
  .vivo__mancha--c {
    --deriva: deriva-c;
    --dur: 26s;
    width: 46vmax;
    aspect-ratio: 1.4;
    top: 6%;
    left: 18%;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--signal) min(100%, calc(44% * var(--g))), transparent) 0%, transparent 100%);
  }

  /* Un destello claro que viaja: le da brillo al lima. */
  .vivo__mancha--d {
    --deriva: deriva-d;
    --dur: 22s;
    width: 26vmax;
    aspect-ratio: 1;
    top: 8%;
    right: 18%;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--lume-300) min(100%, calc(40% * var(--g))), transparent) 0%, transparent 100%);
  }

  /* Musgo oscuro a la derecha, abajo: el contrapeso. */
  .vivo__mancha--e {
    --deriva: deriva-e;
    --dur: 32s;
    width: 52vmax;
    aspect-ratio: 1;
    bottom: -18vmax;
    right: -10vmax;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--lume-800) min(100%, calc(60% * var(--g))), transparent) 0%, transparent 100%);
  }

  /* Lima tenue a la izquierda, a la altura de los CTA: equilibra la
     composicion con la luz principal. */
  .vivo__mancha--f {
    --deriva: deriva-f;
    --dur: 28s;
    width: 48vmax;
    aspect-ratio: 1;
    top: 24%;
    left: -20vmax;
    background: radial-gradient(closest-side, color-mix(in oklch, var(--glow-a) min(100%, calc(30% * var(--g))), transparent) 0%, transparent 100%);
  }

  .vivo__grano {
    position: absolute;
    inset: 0;
    opacity: 0.22;
    mix-blend-mode: overlay;
    background-image: url('/grano.png');
    background-size: 160px;
  }

  @keyframes deriva-a {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-12%, 10%) scale(1.12); }
    100% { transform: translate(-22%, -4%) scale(0.94); }
  }
  @keyframes deriva-b {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(14%, -8%) scale(1.08); }
    100% { transform: translate(6%, -16%) scale(1.16); }
  }
  @keyframes deriva-c {
    0% { transform: translate(0, 0) rotate(0deg) scale(1); }
    50% { transform: translate(30%, -14%) rotate(24deg) scale(1.2); }
    100% { transform: translate(-18%, 12%) rotate(-12deg) scale(0.9); }
  }
  @keyframes deriva-d {
    0% { transform: translate(0, 0) scale(0.9); }
    50% { transform: translate(-60%, 40%) scale(1.25); }
    100% { transform: translate(-120%, 10%) scale(1); }
  }
  @keyframes deriva-e {
    0% { transform: translate(0, 0) scale(1); }
    100% { transform: translate(-26%, -18%) scale(1.18); }
  }
  @keyframes deriva-f {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(18%, 14%) scale(1.15); }
    100% { transform: translate(8%, -12%) scale(0.92); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vivo__mancha { animation: none; }
  }
</style>
