---
import Aplicacion from '../components/Aplicacion.astro';
import Barra from '../components/Barra.astro';
import Contacto from '../components/Contacto.astro';
import Hero from '../components/Hero.astro';
import Historia from '../components/Historia.astro';
import Layout from '../layouts/Layout.astro';
import Pie from '../components/Pie.astro';
---

<Layout
  title="Frencia · App para registrar tus entrenamientos de gimnasio"
  description="Cargá tu rutina, registrá cada serie con RIR o RPE y seguí tu progreso. Frencia reemplaza el Excel del gimnasio sin decirte qué entrenar."
>
  <Barra />
  <!-- overflow-clip y no hidden: recorta igual pero no crea un contenedor de
       scroll, que confundiria a scroll-target-group de la barra. -->
  <div class="relative z-1 overflow-clip">
    <main id="contenido" tabindex="-1" class="outline-none">
      <Hero />
      <Historia />
      <Aplicacion />
      <Contacto />
    </main>
    <Pie />
  </div>
</Layout>

