---
import Layout from '../layouts/Layout.astro';

// Placeholder hasta tener el diseño de las vistas.
---

<Layout title="Frencia" description="Frencia: planificá y registrá tus entrenamientos.">
  <main class="grid min-h-dvh place-items-center p-6">
    <div class="glass rounded-2xl p-8 text-center">
      <h1 class="type-display">Frencia</h1>
      <p class="type-body-sm mt-2 text-fg-secondary">Landing en construcción.</p>
      <a
        href="https://app.frencia.fit"
        class="type-subtitle mt-6 inline-flex h-11 items-center rounded-pill bg-accent px-5 text-fg-on-accent hover:bg-accent-hover"
      >
        Ir a la app
      </a>
    </div>
  </main>
</Layout>
