---
// Pagina para rutas que no existen. Cloudflare la sirve con estado 404
// (not_found_handling: "404-page" en wrangler.jsonc). Usa las mismas piezas que
// el inicio: fondo vivo, titulo y el boton de acento.
import { ArrowLeft } from '@lucide/astro';
import GradienteVivo from '../components/GradienteVivo.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Página no encontrada · Frencia"
  description="La página que buscás no existe. Volvé al inicio de Frencia para conocer la app."
  indexar={false}
>
  <GradienteVivo />
  <main
    id="contenido"
    tabindex="-1"
    class="relative z-1 mx-auto flex min-h-svh w-full max-w-(--contenido-max) flex-col justify-center gap-7 px-(--pad-pagina) py-20 outline-none max-[900px]:px-5"
  >
    <a class="marca no-underline" href="/" aria-label="Frencia, inicio">FRENCIA.</a>
    <h1 class="titulo-seccion max-w-[20ch]">Esta página no existe.</h1>
    <p class="bajada">Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <a
      href="/"
      class="group inline-flex min-h-(--control-h-lg) w-fit items-center justify-center gap-2.5 rounded-lg bg-accent px-6 text-base leading-none font-semibold text-fg-on-accent no-underline shadow-halo-accent transition-[background-color,box-shadow] duration-(--dur-base) ease-out hover:bg-accent-hover active:bg-accent-press"
    >
      <ArrowLeft aria-hidden="true" size={20} stroke-width={1.75} />
      Volver al inicio
    </a>
  </main>
</Layout>
